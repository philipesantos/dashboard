/// Draft of what contract 1.3.0 adds to wit/v1/widget.wit (feature 005, research R9). Everything
/// of 1.2.0 stays as it is, frozen first under wit/history/1.2.0; the package line becomes
/// `package dashboard:widget@1.3.0;`, and the header says "minor version 3 (feature 005)".

/// Calls the operations of connectors the manifest declares with `"account": true`, as the
/// account connected to that connector. The host adds the credential to the request itself: the
/// plugin never sees it, and nothing it passes can name it. Calls work only while the host runs
/// `update`. A connector the manifest declares without an account is called through
/// `connectors`; through this interface it answers `not-granted`, and the other way round.
/// New in 1.3.0.
interface accounts {
  use connectors.{argument, response, problem};

  variant account-call-error {
    /// The connector is an optional permission the user has not turned on, its approval (or
    /// its approval to use the account) was removed, or the manifest does not declare it with an
    /// account: nothing was sent.
    not-granted,
    /// The host refused the call before sending anything.
    refused(problem),
    /// The request was attempted and produced no response for the plugin. A response that
    /// carried the credential back is `invalid-response`.
    failed(problem),
    /// No account is connected to the connector and its credential is required, or the account
    /// must be connected again: the service refused it, it could not be refreshed, or the
    /// connector now asks for more access than it holds. Nothing was sent, or the response was
    /// dropped. Only the user can connect an account, in the host's controls.
    account-not-connected,
    /// The service answered that the account lacks a paid plan this operation needs, with a
    /// status the connector declares as meaning that. The response was dropped.
    subscription-required,
  }

  /// Calls `operation` of `connector` (an id the manifest declares with an account) with
  /// `arguments`. When no account is connected and the connector's credential is optional, the
  /// request goes without one. One call at a time; the host follows allowed redirects itself and
  /// refreshes an expired token at most once per call.
  call: func(connector: string, operation: string, arguments: list<argument>)
    -> result<response, account-call-error>;
}

/// A widget that fetches data through connectors, some of them as the user's account.
world account-widget {
  import log;
  import connectors;
  import accounts;
  export renderer;
  export updater;
}

/// A widget with connectors, accounts and its own store; the world the host binds.
world account-stored-widget {
  import log;
  import connectors;
  import accounts;
  import storage;
  export renderer;
  export updater;
}
