{
  "$comment": "Draft of what wit/connector.schema.json gains (feature 005, research R3): a top-level optional property `credential`, defined below. Rules a schema cannot state (every destination https, token and revoke on the credential's destinations, authorize on reserved or declared hosts, the identity operation being a parameterless read on a credential destination, `Authorization` only outside the catalog, header names compared without case) are checked by the host, which names the field.",
  "properties": {
    "credential": { "$ref": "#/$defs/credential" }
  },
  "$defs": {
    "https_address": {
      "type": "string",
      "pattern": "^https://[^/?#@\\s]+(/[^?#\\s]*)?$",
      "maxLength": 2048
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "destinations", "header"],
      "properties": {
        "kind": { "enum": ["account", "key"] },
        "required": { "type": "boolean", "default": false },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
        },
        "header": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$" },
        "scheme": { "type": "string", "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]{1,32}$" },
        "account": { "$ref": "#/$defs/account" },
        "access": { "$ref": "#/$defs/access" },
        "subscription_required": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 400, "maximum": 499 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "account" } } },
          "then": { "required": ["account"], "not": { "required": ["access"] } },
          "else": { "not": { "required": ["account"] } }
        },
        {
          "if": { "properties": { "header": { "const": "Authorization" } } },
          "then": { "required": ["scheme"] }
        }
      ]
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "client", "authorize", "token", "access"],
      "properties": {
        "flow": { "enum": ["authorization-code"] },
        "client": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "authorize": { "$ref": "#/$defs/https_address" },
        "token": { "$ref": "#/$defs/https_address" },
        "revoke": { "$ref": "#/$defs/https_address" },
        "scopes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[\\x21\\x23-\\x5B\\x5D-\\x7E]{1,64}$" }
        },
        "access": { "$ref": "#/$defs/access" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "name", "id"],
          "properties": {
            "operation": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
            "name": { "type": "string", "pattern": "^(/[^/]{1,64}){1,8}$" },
            "id": { "type": "string", "pattern": "^(/[^/]{1,64}){1,8}$" }
          }
        },
        "access_page": { "$ref": "#/$defs/https_address" },
        "revoke_page": { "$ref": "#/$defs/https_address" }
      }
    },
    "access": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "level": { "enum": ["read", "write"] }
        }
      }
    }
  }
}
