{
  "$schema": "../../wit/connector.schema.json",
  "connector_version": 1,
  "id": "catalog/github",
  "version": "1.1.0",
  "author": "Dashboard contributors",
  "description": "Data of GitHub repositories: public without an account, private ones the user picks with one",
  "reserves": [
    "github.com"
  ],
  "destinations": {
    "api": "https://api.github.com"
  },
  "credential": {
    "kind": "account",
    "required": false,
    "destinations": [
      "api"
    ],
    "header": "Authorization",
    "scheme": "Bearer",
    "account": {
      "flow": "device",
      "client": "github",
      "device": "https://github.com/login/device/code",
      "token": "https://github.com/login/oauth/access_token",
      "scopes": [],
      "access": [
        {
          "name": "Contents",
          "level": "read"
        },
        {
          "name": "Metadata",
          "level": "read"
        }
      ],
      "identity": {
        "operation": "get-user",
        "name": "/login",
        "id": "/id"
      },
      "access_page": "https://github.com/apps/{app}/installations/new",
      "revoke_page": "https://github.com/settings/apps/authorizations"
    },
    "subscription_required": []
  },
  "operations": {
    "get-repository": {
      "kind": "read",
      "method": "GET",
      "destination": "api",
      "path": "/repos/{owner}/{repo}",
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "parameters": {
        "owner": {
          "type": "text",
          "max_length": 39,
          "pattern": "[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?"
        },
        "repo": {
          "type": "text",
          "max_length": 100,
          "pattern": "[A-Za-z0-9._-]+"
        }
      },
      "response": {
        "format": "json",
        "headers": [
          "ETag",
          "X-RateLimit-Remaining",
          "X-RateLimit-Reset"
        ]
      }
    },
    "list-releases": {
      "kind": "read",
      "method": "GET",
      "destination": "api",
      "path": "/repos/{owner}/{repo}/releases",
      "query": {
        "per_page": "{per_page}",
        "page": "{page}"
      },
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "parameters": {
        "owner": {
          "type": "text",
          "max_length": 39,
          "pattern": "[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?"
        },
        "repo": {
          "type": "text",
          "max_length": 100,
          "pattern": "[A-Za-z0-9._-]+"
        },
        "per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "required": false
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "required": false
        }
      },
      "response": {
        "format": "json",
        "headers": [
          "Link",
          "ETag",
          "X-RateLimit-Remaining",
          "X-RateLimit-Reset"
        ]
      }
    },
    "list-issues": {
      "kind": "read",
      "method": "GET",
      "destination": "api",
      "path": "/repos/{owner}/{repo}/issues",
      "query": {
        "state": "{state}",
        "per_page": "{per_page}",
        "page": "{page}"
      },
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "parameters": {
        "owner": {
          "type": "text",
          "max_length": 39,
          "pattern": "[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?"
        },
        "repo": {
          "type": "text",
          "max_length": 100,
          "pattern": "[A-Za-z0-9._-]+"
        },
        "state": {
          "type": "text",
          "max_length": 6,
          "values": [
            "open",
            "closed",
            "all"
          ],
          "required": false
        },
        "per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "required": false
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "required": false
        }
      },
      "response": {
        "format": "json",
        "headers": [
          "Link",
          "ETag",
          "X-RateLimit-Remaining",
          "X-RateLimit-Reset"
        ]
      }
    },
    "get-user": {
      "kind": "read",
      "method": "GET",
      "destination": "api",
      "path": "/user",
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "parameters": {},
      "response": {
        "format": "json",
        "headers": []
      }
    }
  }
}
