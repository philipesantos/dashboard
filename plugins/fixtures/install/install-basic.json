{
  "$schema": "../../../wit/manifest.schema.json",
  "manifest_version": 1,
  "id": "github.com/dashboard-fixtures/install-basic",
  "version": "0.1.0",
  "author": "Dashboard contributors",
  "name": "Instalação básica",
